{
  "name": "n8n-nodes-pverify",
  "version": "1.0.0",
  "description": "n8n community node for pVerify healthcare eligibility verification API - insurance eligibility, Medicare lookups, benefits verification, and coordination of benefits",
  "keywords": [
    "n8n-community-node-package",
    "healthcare",
    "eligibility",
    "insurance",
    "verification",
    "pverify",
    "270",
    "271",
    "medical-billing",
    "rcm",
    "medicare",
    "medicaid",
    "benefits",
    "edi"
  ],
  "license": "BUSL-1.1",
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-pverify",
  "author": {
    "name": "Velocity BPA, LLC",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-BPA/n8n-nodes-pverify.git"
  },
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-pverify/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "lint": "eslint nodes credentials --ext .ts",
    "lint:fix": "eslint nodes credentials --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PVerifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PVerify/PVerify.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.27.0",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
